{
  "name": "feloop",
  "version": "0.1.0",
  "private": true,
  "description": "A lightweight, model-agnostic feedback loop for production AI systems.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "feloop": "./dist/src/cli.js",
    "ai-feedback-loop": "./dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "example:opsentry": "npm run build && node dist/examples/opsentry.js",
    "example:self-improving": "npm run build && node dist/examples/self-improving-agent.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
